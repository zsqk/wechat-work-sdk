{
  "name": "@zsqk/wecom-sdk",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    "./get-access-token": "./src/get-access-token.ts",
    "./get-jsapi-ticket": "./src/get-jsapi-ticket.ts"
  },
  "tasks": {
    "test": "deno test -A"
  },
  "type": "module",
  "test": {
    "include": [
      "src/**/*.test.ts"
    ]
  },
  "lint": {
    "include": ["src/"],
    "rules": {
      "include": [
        "eqeqeq",
        "guard-for-in",
        "no-inferrable-types",
        "no-self-compare",
        "no-sparse-arrays",
        "no-throw-literal",
        "verbatim-module-syntax"
      ],
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "include": ["src/"],
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "singleQuote": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@zsqk/somefn": "jsr:@zsqk/somefn@^0.1.1"
  }
}
